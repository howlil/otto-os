---
import BrandMark from "./ui/BrandMark.astro";

interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;

const links = [
  { label: "Fitur", href: isSubpage ? "/#manfaat" : "#manfaat" },
  { label: "Beta", href: isSubpage ? "/#cara-kerja" : "#cara-kerja" },
  { label: "FAQ", href: isSubpage ? "/#faq" : "#faq" },
];
---

<header class="site-header-shell">
  <nav aria-label="Navigasi utama" class="site-header-inner">
    <a
      href="/"
      class="shrink-0 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
      aria-label="Otto OS, beranda"
    >
      <BrandMark size={21} />
    </a>

    <ul class="flex flex-wrap items-center justify-end gap-x-2 whitespace-nowrap sm:gap-x-7">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex min-h-11 items-center rounded-md px-1 text-[13px] font-medium text-ink-soft/85 transition-colors duration-150 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header-shell {
    position: relative;
    z-index: 50;
    width: 100%;
    background: var(--color-sky-low);
  }

  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    width: min(1100px, calc(100% - 40px));
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-inline: auto;
  }

  @media (max-width: 640px) {
    .site-header-inner {
      min-height: 68px;
      width: calc(100% - 32px);
    }
  }
</style>
