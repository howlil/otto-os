---
import BrandMark from "./ui/BrandMark.astro";

interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;

const links = [
  { label: "Alur beta", href: isSubpage ? "/#cara-kerja" : "#cara-kerja", visibility: "hidden md:block" },
  { label: "Fitur", href: isSubpage ? "/#manfaat" : "#manfaat" },
  { label: "Persyaratan", href: isSubpage ? "/#persyaratan" : "#persyaratan", visibility: "hidden sm:block" },
  { label: "FAQ", href: isSubpage ? "/#faq" : "#faq" },
];
---

<header data-site-nav class="site-nav-shell">
  <nav aria-label="Navigasi utama" class="site-nav">
    <a
      href="/"
      class="shrink-0 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
      aria-label="Otto OS, beranda"
    >
      <BrandMark size={20} />
    </a>

    <div class="flex items-center gap-4 sm:gap-6">
      <ul class="flex items-center gap-4 whitespace-nowrap sm:gap-6">
        {links.map((link) => (
          <li class={link.visibility}>
            <a
              href={link.href}
              class="rounded-md px-1 py-1 text-sm text-ink-soft transition-colors duration-150 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={isSubpage ? "/#daftar" : "#daftar"}
        class="inline-flex h-9 shrink-0 items-center rounded-lg bg-accent px-4 text-sm font-medium whitespace-nowrap text-ink shadow-[inset_0_1px_0_rgb(255_255_255/0.35)] transition-[background-color,transform] duration-150 ease-[cubic-bezier(0.22,1,0.36,1)] hover:bg-accent-hover active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      >
        Daftar beta
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-nav]");
  if (header) {
    const update = () => header.classList.toggle("is-scrolled", window.scrollY > 24);
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>

<style>
  .site-nav-shell {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding-inline: 16px;
    padding-top: 0;
    transition: padding-top 200ms var(--ease-standard);
  }

  .site-nav {
    display: flex;
    width: 100%;
    max-width: 72rem;
    min-height: var(--site-nav-height);
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-inline: auto;
    padding-inline: 0;
    border: 1px solid transparent;
    border-radius: 14px;
    background: transparent;
    transition:
      padding 200ms var(--ease-standard),
      border-color 200ms var(--ease-standard),
      background-color 200ms var(--ease-standard),
      box-shadow 200ms var(--ease-standard),
      backdrop-filter 200ms var(--ease-standard);
  }

  .is-scrolled.site-nav-shell {
    padding-top: 12px;
  }

  .is-scrolled .site-nav {
    padding-inline: 20px;
    border-color: rgb(255 255 255 / 72%);
    background: color-mix(in srgb, var(--color-surface) 84%, var(--color-sky-top));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 80%),
      0 8px 24px -12px rgb(15 17 21 / 18%);
    backdrop-filter: blur(18px) saturate(1.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav-shell,
    .site-nav {
      transition: none;
    }
  }
</style>
