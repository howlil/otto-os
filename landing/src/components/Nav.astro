---
import { ArrowUpRight } from "lucide-astro";
import BrandMark from "./ui/BrandMark.astro";

interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;

const links = [
  { label: "Fitur", href: isSubpage ? "/#manfaat" : "#manfaat" },
  { label: "Beta", href: isSubpage ? "/#cara-kerja" : "#cara-kerja" },
  { label: "FAQ", href: isSubpage ? "/#faq" : "#faq" },
];
---

<header class="site-header-shell">
  <nav aria-label="Navigasi utama" class="site-header-inner">
    <a
      href="/"
      class="shrink-0 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
      aria-label="Otto OS, beranda"
    >
      <BrandMark size={21} />
    </a>

    <div class="flex items-center gap-6 sm:gap-9">
      <ul class="hidden items-center gap-7 whitespace-nowrap sm:flex">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-md py-2 text-[13px] font-medium text-ink-soft/85 transition-colors duration-150 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={isSubpage ? "/#daftar" : "#daftar"}
        data-waitlist-trigger={isSubpage ? undefined : ""}
        class="inline-flex h-10 shrink-0 items-center justify-center gap-1.5 rounded-full bg-ink px-5 text-[13px] font-medium text-white whitespace-nowrap transition-colors duration-150 hover:bg-[#343434] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      >
        Join Beta <ArrowUpRight size={14} strokeWidth={1.7} />
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header-shell {
    position: relative;
    z-index: 50;
    width: 100%;
    background: #fdfdfd;
  }

  .site-header-inner {
    display: flex;
    width: min(1100px, calc(100% - 40px));
    min-height: 76px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-inline: auto;
  }

  @media (max-width: 640px) {
    .site-header-inner {
      min-height: 68px;
      width: calc(100% - 32px);
    }
  }
</style>
