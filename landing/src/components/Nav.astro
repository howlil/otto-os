---
import BrandMark from "./ui/BrandMark.astro";
import { T } from "./lib/T";

interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;
const home = isSubpage ? "/" : "";
---

<header class="sticky top-0 z-50 bg-page">
  <nav aria-label="Navigasi utama" class="mx-auto flex h-16 w-full max-w-[1200px] items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="inline-flex min-h-11 items-center rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
      <BrandMark size={22} />
    </a>
    <div class="flex items-center gap-5 sm:gap-7">
      <a
        href={`${home}#bagian`}
        class="inline-flex min-h-11 items-center rounded-sm text-[14px] font-medium text-ink-soft transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        <T id="Bagian" en="Parts" />
      </a>
      <a
        href={`${home}#unduh`}
        class="hidden min-h-11 items-center rounded-sm text-[14px] font-medium text-ink-soft transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:inline-flex"
      >
        <T id="Unduh" en="Download" />
      </a>
      <div class="flex items-center rounded-full bg-black/[0.05] p-0.5" role="group">
        <span class="sr-only"><T id="Bahasa" en="Language" /></span>
        <button
          type="button"
          data-lang-set="id"
          aria-pressed="true"
          class="h-8 rounded-full px-3 text-[13px] font-medium text-muted transition-colors duration-200 aria-pressed:bg-paper aria-pressed:text-ink aria-pressed:shadow-[0_1px_2px_rgb(0_0_0/0.08)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          ID
        </button>
        <button
          type="button"
          data-lang-set="en"
          aria-pressed="false"
          class="h-8 rounded-full px-3 text-[13px] font-medium text-muted transition-colors duration-200 aria-pressed:bg-paper aria-pressed:text-ink aria-pressed:shadow-[0_1px_2px_rgb(0_0_0/0.08)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          EN
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-lang-set]");

  function applyLanguage(lang: "id" | "en") {
    document.documentElement.dataset.lang = lang;
    document.documentElement.lang = lang;
    buttons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.langSet === lang));
    });
    try {
      localStorage.setItem("otto-lang", lang);
    } catch {}
  }

  applyLanguage(document.documentElement.dataset.lang === "en" ? "en" : "id");

  buttons.forEach((button) => {
    button.addEventListener("click", () => applyLanguage(button.dataset.langSet === "en" ? "en" : "id"));
  });
</script>
