---
import BrandMark from "./ui/BrandMark.astro";
import { T } from "./lib/T";

interface Props {
  isSubpage?: boolean;
}

const { isSubpage = false } = Astro.props;
const home = isSubpage ? "/" : "";
const navLink =
  "min-h-11 items-center rounded-sm text-[14px] font-medium text-ink-soft transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<header class="sticky top-0 z-50 border-b border-line bg-page/90 backdrop-blur-md">
  <nav aria-label="Navigasi utama" class="mx-auto flex h-14 w-full max-w-[1200px] items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="inline-flex min-h-11 shrink-0 items-center rounded-md whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
      <BrandMark size={22} />
    </a>
    <div class="flex shrink-0 items-center gap-4 sm:gap-7">
      <a href={`${home}#notch`} class={`hidden md:inline-flex ${navLink}`}>Notch</a>
      <a href={`${home}#dock`} class={`hidden md:inline-flex ${navLink}`}>Dock</a>
      <a href={`${home}#fokus`} class={`hidden lg:inline-flex ${navLink}`}>Focus</a>
      <a href={`${home}#tampilan`} class={`hidden sm:inline-flex ${navLink}`}>
        <T id="Material" en="Materials" />
      </a>
      <a href={`${home}#unduh`} class={`inline-flex ${navLink}`}>
        <T id="Unduh" en="Download" />
      </a>
      <div class="flex items-center rounded-full bg-black/[0.05] p-0.5" role="group">
        <span class="sr-only"><T id="Bahasa" en="Language" /></span>
        <button
          type="button"
          data-lang-set="id"
          aria-pressed="true"
          class="h-8 rounded-full px-3 text-[13px] font-medium text-muted transition-colors duration-200 aria-pressed:bg-paper aria-pressed:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          ID
        </button>
        <button
          type="button"
          data-lang-set="en"
          aria-pressed="false"
          class="h-8 rounded-full px-3 text-[13px] font-medium text-muted transition-colors duration-200 aria-pressed:bg-paper aria-pressed:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          EN
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-lang-set]");

  function applyLanguage(lang: "id" | "en") {
    document.documentElement.dataset.lang = lang;
    document.documentElement.lang = lang;
    buttons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.langSet === lang));
    });
    try {
      localStorage.setItem("otto-lang", lang);
    } catch {}
  }

  applyLanguage(document.documentElement.dataset.lang === "en" ? "en" : "id");

  buttons.forEach((button) => {
    button.addEventListener("click", () => applyLanguage(button.dataset.langSet === "en" ? "en" : "id"));
  });
</script>
