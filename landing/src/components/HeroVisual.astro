---
import {
  BatteryFull,
  Bell,
  Bluetooth,
  ChevronDown,
  ChevronLeft,
  ChevronRight,
  CircleHelp,
  Code2,
  Download,
  FileCode2,
  FileText,
  Folder,
  Globe2,
  LayoutGrid,
  List,
  Maximize2,
  Music2,
  Pause,
  Play,
  RotateCcw,
  Search,
  Settings2,
  SkipBack,
  SkipForward,
  SlidersHorizontal,
  Terminal,
  Trash2,
  Volume2,
  Wifi,
  X,
} from "lucide-astro";

const apps = [
  { key: "explorer", title: "Explorer", icon: Folder, tile: "explorer", running: true },
  { key: "browser", title: "Browser", icon: Globe2, tile: "browser", running: true },
  { key: "terminal", title: "Terminal", icon: Terminal, tile: "terminal", running: true },
  { key: "code", title: "Code", icon: Code2, tile: "code", running: false },
  { key: "music", title: "Music", icon: Music2, tile: "music", running: true },
  { key: "notes", title: "Notes", icon: FileText, tile: "notes", running: false },
];

const folders = [
  { title: "Projects", detail: "12 items", icon: Folder, tone: "blue" },
  { title: "Documents", detail: "38 items", icon: Folder, tone: "gold" },
  { title: "Pictures", detail: "106 items", icon: Folder, tone: "purple" },
];

const recent = [
  { name: "otto-os", type: "File folder", date: "Today" },
  { name: "landing-design.fig", type: "Figma file", date: "Yesterday" },
  { name: "release-notes.md", type: "Markdown file", date: "Nov 14" },
];
---

<figure class="otto-hero-figure mx-auto w-full" aria-label="Simulasi desktop Otto OS, disusun mengikuti ukuran dan susunan komponen pada implementasi native Windows.">
  <div class="otto-stage-frame" data-otto-hero>
    <div class="otto-stage" data-otto-stage>
      <svg class="otto-wallpaper" viewBox="0 0 1200 750" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs>
          <linearGradient id="otto-wall" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#8fcaf0" />
            <stop offset=".48" stop-color="#d9eafa" />
            <stop offset="1" stop-color="#e5ddf6" />
          </linearGradient>
          <linearGradient id="otto-ribbon-a" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#c9ecff" />
            <stop offset=".55" stop-color="#80b6ee" />
            <stop offset="1" stop-color="#5c81d9" />
          </linearGradient>
          <linearGradient id="otto-ribbon-b" x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#75b4ec" />
            <stop offset=".55" stop-color="#d9e9fa" />
            <stop offset="1" stop-color="#c4c9f2" />
          </linearGradient>
          <filter id="otto-glow"><feGaussianBlur stdDeviation="26" /></filter>
        </defs>
        <rect width="1200" height="750" fill="url(#otto-wall)" />
        <ellipse cx="640" cy="130" rx="470" ry="230" fill="#ffffff" opacity=".30" filter="url(#otto-glow)" />
        <path d="M-90 590 C 150 230, 580 135, 1230 330 L1230 760 L-90 760Z" fill="url(#otto-ribbon-a)" opacity=".42" />
        <path d="M-100 720 C 210 280, 635 420, 1220 90 L 1250 450 C 850 660, 550 585, 340 800Z" fill="url(#otto-ribbon-b)" opacity=".60" />
        <path d="M-70 780 C 230 520, 605 560, 1250 340 L1250 790Z" fill="#e6f4ff" opacity=".45" />
      </svg>

      <div class="otto-bar">
        <div class="otto-menu-start">
          <span class="otto-brand-mini" aria-label="Otto OS">
            <img src="/favicon.svg" width="16" height="16" alt="" aria-hidden="true" />
          </span>
          <strong data-active-app>Explorer</strong>
          <span>File</span>
          <span>Edit</span>
          <span>View</span>
          <span>Window</span>
          <span>Help</span>
        </div>
        <div class="otto-menu-end">
          <ChevronDown size={13} strokeWidth={1.9} />
          <Wifi size={15} strokeWidth={1.8} />
          <Volume2 size={15} strokeWidth={1.8} />
          <BatteryFull size={16} strokeWidth={1.8} />
          <button type="button" class="otto-bar-action" aria-label="Search preview" title="Search preview" data-action="search">
            <Search size={15} strokeWidth={1.8} />
          </button>
          <button type="button" class="otto-bar-action" aria-label="Open Control Center preview" aria-expanded="false" data-action="control-center">
            <SlidersHorizontal size={15} strokeWidth={1.8} />
          </button>
          <button type="button" class="otto-bar-action" aria-label="Show notifications preview" data-action="notifications">
            <Bell size={15} strokeWidth={1.8} />
          </button>
          <span class="otto-clock">Mon 16 Nov&nbsp; 14:02</span>
        </div>
      </div>

      <div class="otto-notch" data-notch>
        <button type="button" class="otto-notch-compact" aria-label="Expand Otto Notch" aria-expanded="false" data-action="notch-open">
          <span class="otto-focus-ring"></span>
          <span class="otto-compact-label" data-compact-label>24:12</span>
          <span class="otto-compact-muted">Focus</span>
          <span class="otto-compact-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        </button>
        <div class="otto-notch-panel" data-notch-panel hidden>
          <div class="otto-notch-head">
            <div class="otto-notch-tabs" role="tablist" aria-label="Notch demo module">
              <button type="button" role="tab" aria-selected="true" data-tab="focus">Focus</button>
              <button type="button" role="tab" aria-selected="false" data-tab="music">Music</button>
            </div>
            <span class="otto-session-label" data-session-label>Session 1 of 4</span>
            <button type="button" class="otto-close-notch" aria-label="Collapse Notch" data-action="notch-close"><X size={13} /></button>
          </div>
          <div class="otto-panel-body otto-focus-body" data-panel-content="focus">
            <div class="otto-timer-ring"><span>25</span></div>
            <div class="otto-timer-main"><strong data-focus-time>24:12</strong><small>Deep focus · Stay in flow</small></div>
            <div class="otto-transport">
              <button type="button" aria-label="Reset focus timer" data-action="focus-reset"><RotateCcw size={15} /></button>
              <button type="button" class="otto-primary-transport" aria-label="Pause focus timer" data-action="focus-toggle"><Pause size={17} fill="currentColor" /></button>
              <button type="button" aria-label="Skip focus session" data-action="focus-skip"><SkipForward size={15} /></button>
            </div>
          </div>
          <div class="otto-panel-body otto-music-body" data-panel-content="music" hidden>
            <span class="otto-album"><Music2 size={21} /></span>
            <div class="otto-song-main"><strong>Slow Morning</strong><small>Otto Sessions · Demo audio</small></div>
            <div class="otto-transport">
              <button type="button" aria-label="Previous track" data-action="music-prev"><SkipBack size={15} /></button>
              <button type="button" class="otto-primary-transport music" aria-label="Pause demo media" data-action="music-toggle"><Pause size={17} fill="currentColor" /></button>
              <button type="button" aria-label="Next track" data-action="music-next"><SkipForward size={15} /></button>
            </div>
          </div>
          <div class="otto-notch-footer">
            <div class="otto-session-progress"><span></span><span></span><span></span><span></span></div>
            <div class="otto-music-progress" hidden><span></span></div>
          </div>
        </div>
      </div>

      <button type="button" class="otto-secondary-notch" title="Switch to Music" aria-label="Switch primary activity to Music" data-action="secondary-notch"><Music2 size={14} /></button>

      <div class="otto-window otto-window-main is-explorer" data-current-app="explorer" data-main-window>
        <div class="otto-window-head">
          <div class="otto-window-tab"><Folder size={15} fill="#e8b553" color="#bb8d38" /><span data-window-name>File Explorer</span><X size={12} color="#7d8492" /></div>
          <div class="otto-window-traffic">
            <button type="button" class="yellow" aria-label="Minimize preview window" title="Minimize" data-action="window-minimize"></button>
            <button type="button" class="green" aria-label="Maximize preview window" title="Maximize" data-action="window-maximize"></button>
            <button type="button" class="red" aria-label="Close preview window" title="Close" data-action="window-close"></button>
          </div>
        </div>
        <div class="otto-window-toolbar">
          <ChevronLeft size={15} /><ChevronRight size={15} /><span class="otto-breadcrumb"><Folder size={14} color="#c69b43" /> Home <ChevronRight size={12} /></span>
          <span class="otto-window-search"><Search size={14} /> Search Home</span>
        </div>
        <div class="otto-window-content">
          <aside class="otto-explorer-sidebar">
            <div class="otto-side-entry active"><Folder size={15} /> Home</div>
            <div class="otto-side-entry"><LayoutGrid size={15} /> Gallery</div>
            <div class="otto-side-divider"></div>
            <div class="otto-side-title">Quick access</div>
            <div class="otto-side-entry"><Folder size={15} color="#d6a14b" /> Desktop</div>
            <div class="otto-side-entry"><Download size={15} color="#5995cf" /> Downloads</div>
            <div class="otto-side-entry"><FileText size={15} color="#87a4c8" /> Documents</div>
            <div class="otto-side-entry"><Folder size={15} color="#8aace0" /> Pictures</div>
            <div class="otto-side-divider"></div>
            <div class="otto-side-entry"><Settings2 size={15} /> This PC</div>
          </aside>
          <div class="otto-explorer-body" data-explorer-body>
            <div class="otto-explorer-heading">Home <span>·</span> Quick access</div>
            <div class="otto-folder-grid">
              {folders.map((folder) => (
                <div class="otto-folder-card">
                  <span class:list={["otto-folder-icon",folder.tone]}><folder.icon size={27} strokeWidth={1.6} fill="currentColor" /></span>
                  <div><strong>{folder.title}</strong><small>{folder.detail}</small></div>
                </div>
              ))}
            </div>
            <div class="otto-files-heading"><span>Recent files</span><List size={14} /></div>
            <div class="otto-file-table">
              <div class="otto-file-row header"><span>Name</span><span>Type</span><span>Modified</span></div>
              {recent.map((file) => (
                <div class="otto-file-row"><span><FileCode2 size={14} /> {file.name}</span><span>{file.type}</span><span>{file.date}</span></div>
              ))}
            </div>
          </div>
        </div>
        <div class="otto-window-status">3 items selected for preview <span>100%</span></div>
      </div>

      <div class="otto-control-center" data-control-center hidden>
        <div class="otto-cc-title">Control Center <button type="button" aria-label="Close Control Center" data-action="control-center-close"><X size={15}/></button></div>
        <div class="otto-cc-grid">
          <button type="button" class="otto-cc-tile active" data-action="wifi-toggle"><Wifi size={17} /><span><strong>Wi-Fi</strong><small data-wifi-label>Connected</small></span></button>
          <button type="button" class="otto-cc-tile active" data-action="bluetooth-toggle"><Bluetooth size={17} /><span><strong>Bluetooth</strong><small data-bluetooth-label>On</small></span></button>
        </div>
        <label class="otto-cc-slider"><span><span>Display</span><span data-brightness-value>80%</span></span><input type="range" min="0" max="100" value="80" data-range="brightness" /></label>
        <label class="otto-cc-slider"><span><span>Sound</span><span data-volume-value>62%</span></span><input type="range" min="0" max="100" value="62" data-range="volume" /></label>
        <div class="otto-cc-now"><Music2 size={15} /> <span>Slow Morning</span> <span class="otto-cc-now-state">Playing</span></div>
        <div class="otto-cc-settings"><Settings2 size={15}/> Otto Modules &amp; Settings <ChevronRight size={14}/></div>
      </div>

      <div class="otto-dock" aria-label="Simulated Otto OS Dock">
        {apps.map((app) => (
          <button type="button" class="otto-dock-entry" data-app={app.key} aria-label={"Open "+app.title+" preview"} aria-pressed={app.key === "explorer" ? "true" : "false"}>
            <span class:list={["otto-dock-tile", app.tile]}><app.icon size={25} strokeWidth={1.85}/></span>
            <span class:list={["otto-running-dot", { "is-running": app.running }]}></span>
            <span class="otto-dock-tooltip">{app.title}</span>
          </button>
        ))}
        <span class="otto-dock-separator"></span>
        <button type="button" class="otto-dock-entry" aria-label="Downloads stack preview" data-action="dock-downloads"><span class="otto-dock-tile downloads"><Download size={25} strokeWidth={1.8}/></span><span class="otto-running-dot"></span><span class="otto-dock-tooltip">Downloads</span></button>
        <button type="button" class="otto-dock-entry" aria-label="Recycle Bin preview" data-action="dock-trash"><span class="otto-dock-tile trash"><Trash2 size={24} strokeWidth={1.75}/></span><span class="otto-running-dot"></span><span class="otto-dock-tooltip">Recycle Bin</span></button>
      </div>

      <span class="sr-only" role="status" aria-live="polite" data-demo-status>Preview siap digunakan</span>
    </div>
  </div>
</figure>

<script>
  const viewport = document.querySelector<HTMLElement>("[data-otto-hero]");
  if (viewport) {
    const stage = viewport.querySelector<HTMLElement>("[data-otto-stage]");
    const resize = () => {
      if (stage) stage.style.transform = "scale(" + viewport.clientWidth / 1200 + ")";
    };
    resize();
    const observer = new ResizeObserver(resize);
    observer.observe(viewport);

    const find = (selector: string) => viewport.querySelector<HTMLElement>(selector);
    const status = (message: string) => {
      const output = find("[data-demo-status]");
      if (output) output.textContent = message;
    };
    const expanded = find("[data-notch-panel]");
    const toggle = find('[data-action="notch-open"]');
    const secondary = find('[data-action="secondary-notch"]');
    const sceneNotch = find("[data-notch]");
    let focusSeconds = 24 * 60 + 12;
    let focusRunning = true;
    let musicPlaying = true;
    let activeTab = "focus";
    let mainApp = "explorer";
    let wifiOn = true;
    let bluetoothOn = true;

    const format = (seconds: number) =>
      String(Math.floor(seconds / 60)).padStart(2, "0") + ":" + String(seconds % 60).padStart(2, "0");
    const renderTimer = () => {
      const label = format(focusSeconds);
      const main = find("[data-focus-time]");
      const compact = find("[data-compact-label]");
      if (main) main.textContent = label;
      if (compact && activeTab === "focus") compact.textContent = label;
    };
    const selectTab = (tab: string) => {
      activeTab = tab;
      viewport.querySelectorAll<HTMLElement>("[data-tab]").forEach((button) => {
        button.setAttribute("aria-selected", String(button.dataset.tab === tab));
      });
      viewport.querySelectorAll<HTMLElement>("[data-panel-content]").forEach((body) => {
        body.hidden = body.dataset.panelContent !== tab;
      });
      const label = find("[data-session-label]");
      if (label) label.textContent = tab === "focus" ? "Session 1 of 4" : "Demo media";
      const focusProgress = find(".otto-session-progress");
      const musicProgress = find(".otto-music-progress");
      if (focusProgress) focusProgress.hidden = tab !== "focus";
      if (musicProgress) musicProgress.hidden = tab !== "music";
      const compact = find("[data-compact-label]");
      if (compact) compact.textContent = tab === "focus" ? format(focusSeconds) : "Slow Morning";
      const muted = find(".otto-compact-muted");
      if (muted) muted.textContent = tab === "focus" ? "Focus" : "Music";
      const secondaryLabel = find('[data-action="secondary-notch"]');
      if (secondaryLabel) secondaryLabel.setAttribute("aria-label", "Switch primary activity to " + (tab === "focus" ? "Music" : "Focus"));
      status(tab === "focus" ? "Notch · Focus session" : "Notch · Music controls");
    };
    const showNotch = (open: boolean) => {
      if (!expanded || !toggle || !sceneNotch) return;
      expanded.hidden = !open;
      toggle.hidden = open;
      sceneNotch.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      if (secondary) secondary.hidden = open;
      if (open) status("Notch expanded · Switch between Focus and Music");
    };
    const openCC = (open: boolean) => {
      const panel = find("[data-control-center]");
      const trigger = find('[data-action="control-center"]');
      if (!panel || !trigger) return;
      panel.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
      if (open) status("Control Center · Local preview controls");
    };
    const presentApp = (app: string) => {
      mainApp = app;
      const names: Record<string, string> = { explorer:"Explorer",browser:"Browser",terminal:"Terminal",code:"Code",music:"Music",notes:"Notes" };
      const title = names[app] ?? "Explorer";
      const appTitle = find("[data-active-app]");
      const windowTitle = find("[data-window-name]");
      const mainWindow = find("[data-main-window]");
      if (appTitle) appTitle.textContent = title;
      if (windowTitle) windowTitle.textContent = title === "Explorer" ? "File Explorer" : title;
      if (mainWindow) {
        mainWindow.hidden = false;
        mainWindow.classList.remove("is-minimized", "is-maximized");
        mainWindow.classList.toggle("is-explorer", app === "explorer");
        mainWindow.dataset.currentApp = app;
      }
      viewport.querySelectorAll<HTMLElement>("[data-app]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.app === app)));
      const body = find("[data-explorer-body]");
      if (body) {
        if (app === "explorer") {
          body.innerHTML = body.dataset.originalMarkup || body.innerHTML;
        } else {
          if (!body.dataset.originalMarkup) body.dataset.originalMarkup = body.innerHTML;
          const mock = app === "terminal" ? "C:\\Users\\Otto> cargo run\n    Compiling otto-os...\n    Finished dev profile" : app === "code" ? "fn main() {\n    println!(\"Hello, Otto OS\");\n}" : app === "music" ? "Now playing\nSlow Morning — Otto Sessions" : app === "browser" ? "Your tabs, your desktop.\nA new way to stay organized." : "Today's notes\nSmall controls. Less interruption.";
          body.textContent = mock;
          body.classList.add("otto-demo-plain");
        }
        if (app === "explorer") body.classList.remove("otto-demo-plain");
      }
      status(title + " · Preview window selected");
    };

    viewport.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const control = target.closest<HTMLElement>("[data-action]");
      const app = target.closest<HTMLElement>("[data-app]");
      const tab = target.closest<HTMLElement>("[data-tab]");
      if (app?.dataset.app) { presentApp(app.dataset.app); return; }
      if (tab?.dataset.tab) { selectTab(tab.dataset.tab); return; }
      if (!control) return;
      const action = control.dataset.action;
      if (action === "notch-open") showNotch(true);
      if (action === "notch-close") showNotch(false);
      if (action === "secondary-notch") selectTab(activeTab === "focus" ? "music" : "focus");
      if (action === "focus-toggle") {
        focusRunning = !focusRunning;
        control.innerHTML = focusRunning ? '<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>' : '<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="m8 5 12 7-12 7z"/></svg>';
        control.setAttribute("aria-label", focusRunning ? "Pause focus timer" : "Resume focus timer");
      }
      if (action === "focus-reset" || action === "focus-skip") {
        focusSeconds = action === "focus-skip" ? 5 * 60 : 25 * 60;
        focusRunning = action !== "focus-skip";
        renderTimer();
        status(action === "focus-skip" ? "Focus · Short break preview" : "Focus · Timer reset");
      }
      if (action === "music-toggle") {
        musicPlaying = !musicPlaying;
        control.innerHTML = musicPlaying ? '<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>' : '<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="m8 5 12 7-12 7z"/></svg>';
        control.setAttribute("aria-label", musicPlaying ? "Pause demo media" : "Play demo media");
        status("Music · " + (musicPlaying ? "Playing" : "Paused"));
      }
      if (action === "music-prev" || action === "music-next") status("Music · Sample track selected");
      if (action === "control-center") openCC(find("[data-control-center]")?.hidden ?? true);
      if (action === "control-center-close") openCC(false);
      if (action === "wifi-toggle" || action === "bluetooth-toggle") {
        if (action === "wifi-toggle") wifiOn = !wifiOn; else bluetoothOn = !bluetoothOn;
        const isOn = action === "wifi-toggle" ? wifiOn : bluetoothOn;
        control.classList.toggle("active", isOn);
        const text = find(action === "wifi-toggle" ? "[data-wifi-label]" : "[data-bluetooth-label]");
        if (text) text.textContent = action === "wifi-toggle" ? (isOn ? "Connected" : "Off") : (isOn ? "On" : "Off");
        status("Control Center · " + (isOn ? "Enabled" : "Disabled"));
      }
      if (action === "window-minimize" || action === "window-close") {
        find("[data-main-window]")?.classList.add("is-minimized");
        status("Click any Dock app to restore the preview window");
      }
      if (action === "window-maximize") {
        const window = find("[data-main-window]");
        window?.classList.toggle("is-maximized");
        status("Window · Size changed");
      }
      if (action === "dock-downloads") status("Dock · Downloads stack preview");
      if (action === "dock-trash") status("Dock · Recycle Bin preview");
      if (action === "search") status("Top Bar · Search preview");
      if (action === "notifications") status("Top Bar · Notifications preview");
    });

    viewport.querySelectorAll<HTMLInputElement>("[data-range]").forEach((slider) => {
      slider.addEventListener("input", () => {
        const label = find(slider.dataset.range === "volume" ? "[data-volume-value]" : "[data-brightness-value]");
        if (label) label.textContent = slider.value + "%";
      });
    });
    window.setInterval(() => {
      if (!document.hidden && focusRunning && focusSeconds > 0) {
        focusSeconds -= 1;
        renderTimer();
      }
    }, 1000);
    selectTab("focus");
  }
</script>

<style>
  .otto-hero-figure{max-width:1200px}
  .otto-stage-frame{position:relative;isolation:isolate;aspect-ratio:8/5;width:100%;overflow:hidden;border:1px solid #e5e8eb;border-radius:18px;background:#d5e5f5;box-shadow:0 24px 64px -43px rgba(28,48,68,.28)}
  .otto-stage{position:absolute;top:0;left:0;width:1200px;height:750px;transform-origin:top left;color:#1e242e;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;text-align:left;overflow:hidden}
  .otto-wallpaper{position:absolute;inset:0;width:100%;height:100%}
  .otto-stage button{cursor:pointer;font:inherit}
  .otto-stage button:focus-visible{outline:2px solid #ff6a2b;outline-offset:3px}
  .otto-bar{position:absolute;top:0;left:0;right:0;height:32px;display:flex;align-items:center;justify-content:space-between;padding:0 8px 0 9px;z-index:8;background:rgba(244,249,255,.47);border-bottom:1px solid rgba(255,255,255,.65);box-shadow:inset 0 1px 0 rgba(255,255,255,.35);backdrop-filter:blur(15px) saturate(1.5);-webkit-backdrop-filter:blur(15px) saturate(1.5);font-size:12px;white-space:nowrap}
  .otto-menu-start,.otto-menu-end{display:flex;align-items:center;gap:15px;height:100%}
  .otto-menu-start{gap:16px}
  .otto-menu-start strong{font-weight:700;font-size:12px}
  .otto-brand-mini{width:22px;display:grid;place-items:center}
