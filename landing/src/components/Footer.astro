---
import BrandMark from "./ui/BrandMark.astro";
import { T } from "./lib/T";

interface Props {
  activePath?: string;
}

const { activePath = "/" } = Astro.props;
const repoUrl = "https://github.com/howlil/otto-os";
const issuesUrl = "https://github.com/howlil/otto-os/issues";
const linkClass =
  "inline-flex min-h-11 items-center rounded-sm text-[14px] text-ink-soft transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<footer class="border-t border-line bg-page px-5 py-10 sm:px-8">
  <div class="mx-auto flex w-full max-w-[1200px] flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-1.5">
      <BrandMark size={20} />
      <span class="text-[13px] text-muted">
        <T id="Shell desktop untuk Windows 11 · Lisensi MIT" en="Desktop shell for Windows 11 · MIT License" />
      </span>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-6 gap-y-1">
      <a href="/privacy" aria-current={activePath === "/privacy" ? "page" : undefined} class={linkClass}>
        <T id="Kebijakan privasi" en="Privacy policy" />
      </a>
      <a href={repoUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>GitHub</a>
      <a href={issuesUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
        <T id="Isu & dukungan" en="Issues & support" />
      </a>
    </nav>
  </div>
</footer>
