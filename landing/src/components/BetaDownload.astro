---
import { Download } from "lucide-astro";
import { T } from "./lib/T";
---

<div class="flex flex-col items-center gap-4">
  <button
    type="button"
    data-beta-download
    class="inline-flex h-11 items-center justify-center gap-2 whitespace-nowrap rounded-full surface-logo px-6 text-[16px] font-medium text-white transition-[filter] duration-200 hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
  >
    <Download size={18} strokeWidth={1.8} aria-hidden="true" />
    <span data-beta-label><T id="Unduh Otto OS" en="Download Otto OS" /></span>
  </button>
  <div class="flex min-h-9 items-center justify-center">
    <p role="status" aria-live="polite" class="text-sm text-muted" data-beta-status><span class="l-id"></span><span class="l-en"></span></p>  </div>
</div>

<script>
  type Release = {
    version: string | null;
    downloadUrl: string | null;
    downloads: number | null;
    prerelease: boolean;
  };

  type ApiPayload = {
    version: string | null;
    downloadUrl: string | null;
    downloads: number;
    prerelease?: boolean;
  };

  type InstallerAsset = {
    name: string;
    browser_download_url: string;
    download_count: number;
  };

  const RELEASE_API = "/api/beta-downloads";
  const RELEASES_API = "https://api.github.com/repos/howlil/otto-os/releases?per_page=100";
  const DOWNLOAD_PREFIX = "https://github.com/howlil/otto-os/releases/download/";
  const INSTALLER_NAME = /^otto-os-setup-\d+(?:\.\d+)*-x64\.exe$/i;
  const idFormat = new Intl.NumberFormat("id-ID");
  const enFormat = new Intl.NumberFormat("en-US");

  let current: Release | null = null;
  let inFlight: Promise<Release | null> | null = null;
  let busy = false;

  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === "object" && value !== null;
  }

  function isApiPayload(value: unknown): value is ApiPayload {
    return (
      isRecord(value) &&
      (typeof value.version === "string" || value.version === null) &&
      (typeof value.downloadUrl === "string" || value.downloadUrl === null) &&
      Number.isInteger(value.downloads) &&
      Number(value.downloads) >= 0 &&
      (typeof value.prerelease === "boolean" || value.prerelease === undefined)
    );
  }

  function isInstallerUrl(url: string): boolean {
    return url.startsWith(DOWNLOAD_PREFIX);
  }

  function isInstallerAsset(value: unknown): value is InstallerAsset {
    return (
      isRecord(value) &&
      typeof value.name === "string" &&
      INSTALLER_NAME.test(value.name) &&
      typeof value.browser_download_url === "string" &&
      Number.isInteger(value.download_count) &&
      Number(value.download_count) >= 0
    );
  }

  async function fetchFromApi(): Promise<Release | null> {
    try {
      const response = await fetch(RELEASE_API, { headers: { Accept: "application/json" } });
      if (!response.ok) return null;
      const payload: unknown = await response.json();
      if (!isApiPayload(payload)) return null;
      const downloadUrl = payload.downloadUrl && isInstallerUrl(payload.downloadUrl) ? payload.downloadUrl : null;
      return {
        version: payload.version,
        downloadUrl,
        downloads: payload.downloads,
        prerelease: payload.prerelease === true,
      };
    } catch {
      return null;
    }
  }

  async function fetchFromGitHub(): Promise<Release | null> {
    try {
      const response = await fetch(RELEASES_API, { headers: { Accept: "application/vnd.github+json" } });
      if (!response.ok) return null;
      const payload: unknown = await response.json();
      if (!Array.isArray(payload)) return null;
      const releases = payload.filter(
        (release): release is Record<string, unknown> =>
          isRecord(release) && release.draft !== true && typeof release.tag_name === "string" && Array.isArray(release.assets),
      );
      const installersOf = (release: Record<string, unknown>) => (release.assets as unknown[]).filter(isInstallerAsset);
      const downloads = releases.reduce(
        (total, release) => total + installersOf(release).reduce((sum, asset) => sum + asset.download_count, 0),
        0,
      );
      const latest = [
        ...releases.filter((release) => release.prerelease !== true),
        ...releases.filter((release) => release.prerelease === true),
      ].find((release) => installersOf(release).some((asset) => isInstallerUrl(asset.browser_download_url)));
      const installer = latest
        ? installersOf(latest).find((asset) => isInstallerUrl(asset.browser_download_url))
        : undefined;
      const incomplete = /\brel="next"/.test(response.headers.get("link") ?? "");
      return {
        version: latest && installer ? String(latest.tag_name) : null,
        downloadUrl: installer?.browser_download_url ?? null,
        downloads: incomplete ? null : downloads,
        prerelease: latest?.prerelease === true,
      };
    } catch {
      return null;
    }
  }

  async function fetchLatest(): Promise<Release | null> {
    const fromApi = await fetchFromApi();
    return fromApi ?? (await fetchFromGitHub());
  }

  function refresh(): Promise<Release | null> {
    if (!inFlight) {
      inFlight = fetchLatest().then((release) => {
        current = release;
        inFlight = null;
        render();
        return release;
      });
    }
    return inFlight;
  }

  function instances() {
    return [...document.querySelectorAll<HTMLButtonElement>("[data-beta-download]")].map((button) => {
      const wrapper = button.parentElement;
      return {
        button,
        label: button.querySelector("[data-beta-label]"),
        status: wrapper?.querySelector("[data-beta-status]") ?? null,
      };
    });
  }

  function setBilingual(element: Element | null, id: string, en: string) {
    if (!element) return;
    const idSpan = element.querySelector<HTMLElement>(".l-id");
    const enSpan = element.querySelector<HTMLElement>(".l-en");
    if (idSpan) idSpan.textContent = id;
    if (enSpan) enSpan.textContent = en;
  }

  function showCount(element: Element | null, count: number | null) {
    if (!element) return;
    (element as HTMLElement).hidden = count === null;
    if (count === null) return;
    const idCount = element.querySelector("[data-count-id]");
    const enCount = element.querySelector("[data-count-en]");
    if (idCount) idCount.textContent = idFormat.format(count);
    if (enCount) enCount.textContent = enFormat.format(count);
  }

  function render() {
    const release = current;
    const count = document.querySelector("[data-beta-count]");
    instances().forEach(({ label, status }) => {
      if (release?.downloadUrl) {
        const kind = release.prerelease ? "Beta " : "";
        const version = release.version ?? "";
        setBilingual(label, `Unduh Otto OS ${kind}${version}`, `Download Otto OS ${kind}${version}`);
        setBilingual(status, "", "");
        showCount(count, release.downloads);
      } else if (release) {
        setBilingual(label, "Installer belum tersedia", "Installer not available yet");
        setBilingual(status, "Rilis belum diterbitkan.", "No release published yet.");
        showCount(count, null);
      } else {
        setBilingual(label, "Unduh Otto OS", "Download Otto OS");
        setBilingual(status, "Unduhan belum bisa disiapkan. Klik untuk mencoba lagi.", "The download could not be prepared. Click to try again.");
        showCount(count, null);
      }
    });
  }

  function showPreparing() {
    instances().forEach(({ status }) => setBilingual(status, "Menyiapkan unduhan…", "Preparing download…"));
  }

  function startDownload(url: string) {
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.rel = "noopener";
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
  }

  async function handleClick() {
    if (busy) return;
    busy = true;
    try {
      let release = current;
      if (!release?.downloadUrl) {
        showPreparing();
        release = await refresh();
      }
      if (release?.downloadUrl) startDownload(release.downloadUrl);
    } finally {
      busy = false;
    }
  }

  instances().forEach(({ button }) => {
    button.addEventListener("click", () => void handleClick());
  });

  void refresh();
</script>
