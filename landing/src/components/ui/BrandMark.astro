---
interface Props {
  size?: number;
}

const { size = 22 } = Astro.props;
---

<span class="inline-flex items-center gap-2 text-ink">
  <img src="/favicon.svg" width={size} height={size} alt="" aria-hidden="true" class="shrink-0" decoding="async" />
  <span class="text-base leading-none font-semibold tracking-[-0.02em]">Otto OS</span>
</span>
