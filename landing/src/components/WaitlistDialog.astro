---
import { X } from "lucide-astro";
import WaitlistForm from "./WaitlistForm.tsx";
---

<dialog
  id="otto-waitlist-dialog"
  aria-labelledby="otto-waitlist-title"
  aria-describedby="otto-waitlist-description"
  class="waitlist-dialog fixed inset-0 m-auto max-h-[calc(100dvh-32px)] w-[min(430px,calc(100vw-32px))] max-w-none overflow-y-auto rounded-[28px] border border-white/80 bg-white p-0 text-ink shadow-[0_28px_90px_-30px_rgb(15_17_21/0.45)]"
>
  <div class="px-6 pt-6 pb-7 sm:px-8 sm:pt-8">
    <div class="flex items-start justify-between gap-5">
      <div class="min-w-0">
        <p class="text-xs font-medium tracking-[0.08em] text-muted">OTTO OS · EARLY ACCESS</p>
        <h2 id="otto-waitlist-title" class="mt-3 text-[27px] leading-tight font-semibold tracking-[-0.045em] text-ink">
          Join the beta.
        </h2>
      </div>
      <button
        type="button"
        data-waitlist-close
        aria-label="Tutup formulir beta"
        class="grid size-9 shrink-0 place-items-center rounded-full bg-[#f2f3f4] text-ink-soft transition-colors hover:bg-[#e8eaed] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
      >
        <X size={17} strokeWidth={1.8} />
      </button>
    </div>

    <p id="otto-waitlist-description" class="mt-3 mb-6 max-w-sm text-sm leading-relaxed text-ink-soft">
      Masukkan email untuk menerima undangan mencoba Otto OS di Windows 11.
    </p>

    <WaitlistForm client:load modal />

    <p class="mt-5 text-center text-xs leading-relaxed text-muted">
      Tanpa akun. Undangan dikirim saat akses beta tersedia.
    </p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#otto-waitlist-dialog");
  if (dialog) {
    let lastTrigger: HTMLElement | null = null;
    const open = (trigger: HTMLElement | null = null) => {
      if (dialog.open) return;
      lastTrigger = trigger;
      dialog.showModal();
      dialog.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLAnchorElement>("a[data-waitlist-trigger]");
      if (trigger && !event.defaultPrevented && !(event instanceof MouseEvent && (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey))) {
        event.preventDefault();
        open(trigger);
        return;
      }
      if (target.closest("[data-waitlist-close]") && dialog.open) dialog.close();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) {
        dialog.close();
      }
    });

    dialog.addEventListener("close", () => {
      lastTrigger?.focus();
      lastTrigger = null;
    });

    if (new URLSearchParams(window.location.search).has("waitlist") || window.location.hash === "#daftar") {
      open();
    }
  }
</script>

<style>
  .waitlist-dialog::backdrop {
    background: rgb(15 17 21 / 0.44);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  @media (prefers-reduced-transparency: reduce) {
    .waitlist-dialog::backdrop {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgb(15 17 21 / 0.65);
    }
  }
</style>
