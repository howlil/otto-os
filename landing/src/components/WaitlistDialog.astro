---
import { X } from "lucide-astro";
import WaitlistForm from "./WaitlistForm.tsx";
---

<dialog
  id="otto-waitlist-dialog"
  aria-labelledby="otto-waitlist-title"
  aria-describedby="otto-waitlist-description"
  class="waitlist-dialog fixed inset-0 m-auto max-h-[calc(100dvh-32px)] w-[min(400px,calc(100vw-32px))] max-w-none overflow-y-auto rounded-3xl border border-line bg-surface p-0 text-ink shadow-xl"
>
  <div class="relative px-4 pt-12 pb-5 sm:px-5">
    <h2 id="otto-waitlist-title" class="sr-only">Join Beta</h2>
    <button
      type="button"
      data-waitlist-close
      aria-label="Tutup formulir beta"
      class="absolute top-2 right-2 grid size-8 place-items-center rounded-full text-muted transition-colors hover:bg-surface-subtle hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      <X size={17} strokeWidth={1.8} />
    </button>

    <p id="otto-waitlist-description" class="sr-only">
      Daftar waitlist dengan email. Pendaftaran belum langsung memberi akses aplikasi.
    </p>

    <WaitlistForm client:load />

  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#otto-waitlist-dialog");
  if (dialog) {
    let lastTrigger: HTMLElement | null = null;
    const open = (trigger: HTMLElement | null = null) => {
      if (dialog.open) return;
      lastTrigger = trigger;
      dialog.showModal();
      dialog.querySelector<HTMLInputElement>('input[name="email"]')?.focus();
    };

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest<HTMLAnchorElement>("a[data-waitlist-trigger]");
      if (trigger && !event.defaultPrevented && !(event instanceof MouseEvent && (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey))) {
        event.preventDefault();
        open(trigger);
        return;
      }
      if (target.closest("[data-waitlist-close]") && dialog.open) dialog.close();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) {
        dialog.close();
      }
    });

    dialog.addEventListener("close", () => {
      lastTrigger?.focus();
      lastTrigger = null;
    });

    if (new URLSearchParams(window.location.search).has("waitlist") || window.location.hash === "#daftar") {
      open();
    }
  }
</script>

<style>
  .waitlist-dialog::backdrop {
    background: rgb(15 17 21 / 0.44);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  @media (prefers-reduced-transparency: reduce) {
    .waitlist-dialog::backdrop {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgb(15 17 21 / 0.65);
    }
  }
</style>
