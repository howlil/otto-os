---
const steps = [
  {
    number: "01",
    title: "Gabung waitlist",
    description: "Daftar dengan email tanpa membuat akun.",
  },
  {
    number: "02",
    title: "Terima akses beta",
    description: "Undangan dan penginstal Windows dikirim secara bertahap.",
  },
  {
    number: "03",
    title: "Coba, lalu pulihkan kapan saja",
    description: "Taskbar dan area kerja Windows bisa dikembalikan saat diperlukan.",
  },
];
---

<section id="cara-kerja" class="w-full scroll-mt-24">
  <div class="mb-8 text-left">
    <h2 class="text-[clamp(1.75rem,3vw,2.25rem)] font-medium tracking-[-0.035em] text-ink">Mulai dengan mudah.</h2>
    <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
      Akses awal Otto OS dalam tiga langkah.
    </p>
  </div>

  <ol class="grid gap-6 sm:grid-cols-3 sm:gap-8">
    {steps.map((step) => (
      <li class="flex flex-col gap-3 border-t border-line pt-5 text-left">
        <span class="font-mono text-xs font-medium tabular-nums text-muted">{step.number}</span>
        <div>
          <h3 class="text-base font-medium tracking-[-0.015em] text-ink">{step.title}</h3>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-ink-soft">{step.description}</p>
        </div>
      </li>
    ))}
  </ol>
</section>
