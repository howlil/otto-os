---
const steps = [
  {
    number: "01",
    title: "Unduh installer",
    description: "Unduh langsung dari rilis beta terbaru tanpa formulir atau email.",
  },
  {
    number: "02",
    title: "Pasang di Windows 11",
    description: "Jalankan installer per pengguna untuk Windows 11 x64.",
  },
  {
    number: "03",
    title: "Coba dan beri masukan",
    description: "Versi beta bisa memiliki bug. Laporkan masalah melalui",
  },
];
---

<section id="cara-kerja" aria-labelledby="beta-access-title" class="grid w-full scroll-mt-24 gap-10 border-y border-line py-8 text-left sm:py-10 md:grid-cols-2 md:gap-16">
  <div>
    <h2 id="beta-access-title" class="text-[clamp(1.75rem,3vw,2.25rem)] font-medium tracking-[-0.035em] text-ink">Akses beta Otto OS</h2>
    <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
      Unduh versi beta langsung dari rilis GitHub, tanpa menunggu undangan.
    </p>
    <dl class="mt-6 divide-y divide-line border-y border-line text-sm">
      <div class="flex items-baseline justify-between gap-4 py-3">
        <dt class="text-muted">Rilis</dt>
        <dd class="font-medium text-ink">GitHub Releases</dd>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-3">
        <dt class="text-muted">Platform</dt>
        <dd class="font-medium text-ink">Windows 11 x64</dd>
      </div>
      <div class="flex items-baseline justify-between gap-4 py-3">
        <dt class="text-muted">Akses</dt>
        <dd class="font-medium text-ink">Unduh langsung</dd>
      </div>
    </dl>
    <p class="mt-5 max-w-md text-sm leading-relaxed text-ink-soft">
      Versi beta masih dapat memiliki bug dan perubahan. Cocok untuk pengguna yang bersedia mencoba dan memberi masukan.
    </p>
    <a href="#persyaratan" class="mt-2 inline-flex min-h-11 items-center rounded-sm text-sm text-ink underline underline-offset-4 transition-colors hover:text-ink-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
      Lihat persyaratan
    </a>
  </div>

  <div>
    <h3 class="text-base font-medium tracking-[-0.015em] text-ink">Cara mulai</h3>
    <ol class="mt-5 divide-y divide-line border-t border-line">
      {steps.map((step) => (
        <li class="flex gap-4 py-5">
          <span aria-hidden="true" class="pt-1 font-mono text-xs font-medium tabular-nums text-muted">{step.number}</span>
          <div>
            <h4 class="text-base font-medium tracking-[-0.015em] text-ink">{step.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
              {step.description}
              {step.number === "03" && (
                <>
                  {" "}<a href="https://github.com/howlil/otto-os/issues" class="rounded-sm underline underline-offset-4 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">GitHub Issues</a>.
                </>
              )}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
