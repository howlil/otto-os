---
import { ChevronDown } from "lucide-astro";

const items = [
  {
    title: "Apa itu Otto OS?",
    content:
      "Shell desktop untuk Windows 11 yang menghadirkan bar atas, Dock, kontrol jendela Genie, dan Dynamic Island. Dibangun dengan bahasa Rust dan API Windows asli.",
  },
  {
    title: "Windows versi berapa yang didukung?",
    content: "Windows 11 versi 22H2 atau lebih baru (build 22621+, arsitektur 64-bit x64). Windows 10 belum didukung.",
  },
  {
    title: "Apakah aman jika terjadi crash atau ingin kembali ke taskbar Windows?",
    content:
      "Ya. Otto OS menyimpan salinan area kerja Windows sebelum memodifikasi tampilan dan selalu bisa mengembalikannya saat keluar, maupun melalui perintah otto-os.exe --restore-shell.",
  },
  {
    title: "Apakah sudah siap dipakai harian?",
    content:
      "Belum. Proyek masih di tahap pre-launch menjelang Beta v1.0 sementara optimasi penggunaan CPU idle dan paket rilis diselesaikan.",
  },
  {
    title: "Data apa yang disimpan saat mendaftar waitlist?",
    content:
      "Hanya alamat email, sumber pendaftaran, serta dua pilihan opsional mengenai versi Windows dan kebiasaan berpindah aplikasi. Rincian lengkap ada di halaman kebijakan privasi.",
  },
  {
    title: "Bagaimana cara keluar dari waitlist?",
    content:
      "Balas email undangan kami atau ajukan permintaan melalui halaman dukungan GitHub, dan alamat email kamu akan dihapus.",
  },
];
---

<div class="divide-y divide-line border-y border-line text-left">
  {items.map((item, index) => (
    <details name="otto-faq" open={index === 0} class="faq-item group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-sm font-medium text-ink transition-colors hover:text-ink-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink sm:text-base [&::-webkit-details-marker]:hidden">
        <span>{item.title}</span>
        <ChevronDown
          size={16}
          strokeWidth={1.5}
          aria-hidden="true"
          class="faq-chevron shrink-0 text-muted"
        />
      </summary>
      <div class="pb-4 pr-8 text-sm leading-relaxed text-ink-soft">
        {item.content}
      </div>
    </details>
  ))}
</div>
