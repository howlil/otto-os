---
import { statusItems, type StatusState } from "../content/status";

const badges: Record<StatusState, { label: string; className: string }> = {
  ready: { label: "Siap di beta", className: "text-positive font-medium" },
  "pre-beta": { label: "Menjelang beta", className: "text-warning-ink font-medium" },
  next: { label: "Berikutnya", className: "text-muted font-normal" },
};
---

<div id="status" class="scroll-mt-24 text-left">
  <h2 class="text-xl font-medium tracking-[-0.02em] text-ink sm:text-2xl">Status pengembangan</h2>
  <ul class="mt-4 divide-y divide-line rounded-xl border border-line bg-surface">
    {statusItems.map((item) => {
      const badge = badges[item.state];
      return (
        <li class="flex items-center justify-between gap-4 px-4 py-3.5 text-sm text-ink">
          <span>{item.label}</span>
          <span class={`shrink-0 text-xs ${badge.className}`}>{badge.label}</span>
        </li>
      );
    })}
  </ul>
</div>
