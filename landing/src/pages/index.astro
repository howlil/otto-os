---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BetaDownload from "../components/BetaDownload.astro";
import { T } from "../components/lib/T";
import Hero from "../sections/Hero.astro";
import { PartsStory } from "../components/islands/PartsStory";
import { BarToggle } from "../components/islands/BarToggle";
import { IslandStage } from "../components/islands/IslandStage";
import { DockGenie } from "../components/islands/DockGenie";
import { FocusShowcase } from "../components/islands/FocusShowcase";
import { SettingsScene } from "../components/islands/SettingsScene";
import { Spotlight } from "../components/islands/Spotlight";

const headingClass =
  "text-[clamp(2.25rem,4.4vw,3.5rem)] leading-[1.04] font-semibold tracking-[-0.03em] text-balance";
const leadClass = "text-lg leading-[1.6] text-pretty";
const sectionClass = "mx-auto w-full max-w-[1200px] px-5 sm:px-8";
---

<Base
  title="Otto OS — Bar atas, Dynamic Island, dan Dock untuk Windows 11"
  description="Shell desktop native untuk Windows 11 dengan bar atas, Dynamic Island, Dock, dan efek Genie. Unduh langsung dari GitHub Releases."
>
  <Nav />
  <main id="main-content" class="flex-1">
    <Hero />

    <section id="bagian" class="scroll-mt-20 border-t border-line">
      <div class={`${sectionClass} pt-24 sm:pt-32`}>
        <h2 class={`max-w-[640px] ${headingClass}`}>
          <T id="Setiap bagian punya tugasnya." en="Every part has its job." />
        </h2>
      </div>
      <PartsStory client:visible />
    </section>

    <section id="bar" class="scroll-mt-20 border-t border-line">
      <div class={`${sectionClass} py-24 sm:py-32`}>
        <div class="max-w-[640px]">
          <h2 class={headingClass}>
            <T id="Bar atas bisa berdiri sendiri." en="The top bar can stand alone." />
          </h2>
          <p class={`mt-5 text-ink-soft ${leadClass}`}>
            <T
              id="Matikan bar atas. Notch, Control Center, dan Spotlight tetap aktif."
              en="Turn the top bar off. The notch, Control Center and Spotlight stay active."
            />
          </p>
        </div>
        <div class="mt-14 sm:mt-16">
          <BarToggle client:visible />
        </div>
      </div>
    </section>

    <section id="notch" class="scroll-mt-20 on-stage bg-stage text-stage-ink">
      <div class={`${sectionClass} pt-24 sm:pt-32`}>
        <div class="max-w-[640px]">
          <h2 class={headingClass}>
            <T id="Satu notch, semua modulnya." en="One notch, every module." />
          </h2>
          <p class={`mt-5 max-w-[540px] text-stage-muted ${leadClass}`}>
            <T
              id="Gulir untuk melihat setiap modul. Klik namanya untuk langsung melompat."
              en="Scroll to see each module. Click a name to jump straight there."
            />
          </p>
        </div>
      </div>
      <IslandStage client:visible />
    </section>

    <section class="border-t border-line">
      <div class={`${sectionClass} py-24 sm:py-32`}>
        <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <h2 class={`max-w-[560px] ${headingClass}`}>
            <T id="Minimize masuk ke Dock." en="Minimize into the Dock." />
          </h2>
          <p class={`max-w-[420px] text-ink-soft ${leadClass}`}>
            <T
              id="Animasi Genie untuk minimize dan restore, dengan tombol caption Windows 11."
              en="Genie animations for minimize and restore, with Windows 11 caption buttons."
            />
          </p>
        </div>
        <div class="mt-14 sm:mt-16">
          <DockGenie client:visible />
        </div>
      </div>
    </section>

    <section id="fokus" class="scroll-mt-20 on-stage bg-stage text-stage-ink">
      <div class={`${sectionClass} pt-24 sm:pt-32`}>
        <div class="max-w-[640px]">
          <h2 class={headingClass}>
            <T id="Focus: timer, blokir, dan waktu layar." en="Focus: timer, blocking and screen time." />
          </h2>
          <p class={`mt-5 max-w-[560px] text-stage-muted ${leadClass}`}>
            <T
              id="Pomodoro ada di notch. Blocklist dan aktivitas Today serta 7 hari ada di halaman Focus di Otto Settings, disimpan lokal."
              en="Pomodoro lives in the notch. The blocklist and Today and 7-day activity sit on the Focus page in Otto Settings, stored locally."
            />
          </p>
        </div>
        <div class="mt-14 pb-24 sm:mt-16 sm:pb-32">
          <FocusShowcase client:visible />
        </div>
      </div>
    </section>

    <section id="kontrol" class="scroll-mt-20 border-t border-line bg-paper">
      <div class={`${sectionClass} py-24 sm:py-32`}>
        <div class="max-w-[640px]">
          <h2 class={headingClass}>
            <T id="Kontrol cepat, dan Otto Settings." en="Quick controls, and Otto Settings." />
          </h2>
          <p class={`mt-5 text-ink-soft ${leadClass}`}>
            <T
              id="Ctrl+Alt+C membuka Control Center. Ctrl+Alt+, membuka Otto Settings, jendela terpisah dengan sidebar dan 13 modul."
              en="Ctrl+Alt+C opens Control Center. Ctrl+Alt+, opens Otto Settings, a separate window with a sidebar and 13 modules."
            />
          </p>
        </div>
        <div class="mt-14 sm:mt-16">
          <SettingsScene client:visible />
        </div>
      </div>
    </section>

    <section class="on-stage bg-stage text-stage-ink">
      <div class={`${sectionClass} py-24 text-center sm:py-32`}>
        <h2 class={`mx-auto max-w-[720px] ${headingClass}`}>
          <T id="Cari aplikasi di Spotlight." en="Find apps in Spotlight." />
        </h2>
        <p class={`mx-auto mt-5 max-w-[540px] text-stage-muted ${leadClass}`}>
          <T
            id="Pencarian aplikasi lokal. Ctrl+Alt+Space membukanya. Hanya mencari aplikasi yang terpasang, bukan file atau web."
            en="Local app search. Ctrl+Alt+Space opens it. Search covers installed apps only, not files or the web."
          />
        </p>
        <div class="mt-14 sm:mt-16">
          <Spotlight client:visible />
        </div>
      </div>
    </section>

    <section id="unduh" class="scroll-mt-20 border-t border-line">
      <div class={`${sectionClass} flex flex-col items-start py-28 sm:py-40`}>
        <h2 class="text-[clamp(2.75rem,7vw,6rem)] leading-[0.98] font-semibold tracking-[-0.035em] text-balance">
          <T id="Siap mencoba?" en="Ready to try it?" />
        </h2>
        <p class={`mt-6 max-w-[560px] text-ink-soft ${leadClass}`}>
          <T
            id="Installer per pengguna. Tanpa akun, tanpa telemetri."
            en="Per-user installer. No account, no telemetry."
          />
        </p>
        <div class="mt-10">
          <BetaDownload />
        </div>
        <p class="mt-8 text-[14px] text-muted">
          <T id="Windows 11 22H2 atau lebih baru · x64 · build 22621+" en="Windows 11 22H2 or later · x64 · build 22621+" />
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Base>
