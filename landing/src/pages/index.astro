---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BetaDownload from "../components/BetaDownload.astro";
import AgentStack from "../components/ui/AgentStack.astro";
import { T } from "../components/lib/T";
import Hero from "../sections/Hero.astro";
import { IslandStage } from "../components/islands/IslandStage";
import { TopBarStudio } from "../components/islands/TopBarStudio";
import { DockGenie } from "../components/islands/DockGenie";
import { FocusShowcase } from "../components/islands/FocusShowcase";
import { AppearanceAtelier } from "../components/islands/AppearanceAtelier";
import { ModuleRack } from "../components/islands/ModuleRack";
import { Spotlight } from "../components/islands/Spotlight";

const containerClass = "mx-auto w-full max-w-[1200px] px-5 sm:px-8";
const sectionClass = `${containerClass} py-20 sm:py-28`;
const actHeading = "text-[clamp(2.25rem,4.4vw,3.5rem)] leading-[1.04] font-medium tracking-[-0.035em] text-balance";
const actLead = "mx-auto mt-4 max-w-[540px] text-[17px] leading-[1.5] text-pretty";
const actHead = "mx-auto max-w-[640px] text-center";
const barRow = "flex items-start justify-between gap-6 border-b border-line py-4";
const barRowTitle = "text-[15px] font-medium text-ink";
const barRowText = "max-w-[220px] text-right text-[13.5px] leading-[1.45] text-muted";
---

<Base
  title="Otto OS — Bar atas, Dynamic Island, Dock, dan Liquid Glass untuk Windows 11"
  description="Shell desktop native Rust untuk Windows 11 dengan bar atas, Dynamic Island, Screen Time, Dock Genie, Focus Shield, dan material Liquid Glass."
>
  <Nav />
  <main id="main-content" class="flex-1">
    <Hero />

    <section id="notch" class="scroll-mt-16 on-stage bg-stage text-stage-ink">
      <IslandStage client:visible />
    </section>

    <section id="bar" class="scroll-mt-16 border-t border-line bg-page">
      <div class={sectionClass}>
        <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,0.84fr)_minmax(0,1.16fr)] lg:gap-16">
          <div data-reveal>
            <h2 class={`${actHeading} text-left text-ink`}>
              <T id="Bar atas yang tahu kapan minggir." en="A top bar that knows when to step aside." />
            </h2>
            <p class="mt-4 max-w-[440px] text-[17px] leading-[1.5] text-pretty text-ink-soft">
              <T
                id="Sembunyi saat tidak dibutuhkan. Kalender dan Notification Center tetap satu klik jauhnya."
                en="It hides when you don't need it. The calendar and Notification Center stay one click away."
              />
            </p>
            <ul class="mt-9 border-t border-line">
              <li class={barRow}>
                <span class={barRowTitle}><T id="Kursor di tepi atas" en="Pointer at the top edge" /></span>
                <span class={barRowText}><T id="Bar muncul, lalu menyingkir saat kursor pergi." en="The bar appears, then steps aside." /></span>
              </li>
              <li class={barRow}>
                <span class={barRowTitle}><T id="Klik jam" en="Click the clock" /></span>
                <span class={barRowText}><T id="Kalender bulan ini terbuka tepat di bawah bar." en="This month's calendar opens right beneath the bar." /></span>
              </li>
              <li class={barRow}>
                <span class={barRowTitle}><T id="Klik lonceng" en="Click the bell" /></span>
                <span class={barRowText}><T id="Notification Center dengan kartu yang ringkas." en="Notification Center with compact alert cards." /></span>
              </li>
            </ul>
          </div>
          <div class="min-w-0">
            <TopBarStudio client:visible />
          </div>
        </div>
      </div>
    </section>

    <section id="dock" class="scroll-mt-16 border-t border-line bg-paper">
      <div class={sectionClass}>
        <div data-reveal class={actHead}>
          <h2 class={`${actHeading} text-ink`}>
            <T id="Genie ke Dock." en="Genie into the Dock." />
          </h2>
          <p class={`${actLead} text-ink-soft`}>
            <T
              id="Jendela meluncur ke ikonnya di Dock lewat animasi Genie. Dock membesar mengikuti kursor."
              en="A window warps into its icon in the Dock with the Genie animation. The Dock magnifies under your pointer."
            />
          </p>
        </div>
        <div class="mt-10 sm:mt-12">
          <DockGenie client:visible />
        </div>
      </div>
    </section>

    <section id="fokus" class="scroll-mt-16 on-stage bg-stage text-stage-ink">
      <div class={sectionClass}>
        <div data-reveal class={actHead}>
          <h2 class={`${actHeading} text-stage-ink`}>
            <T id="Focus yang melindungi, bukan memaksa." en="Focus that protects, never forces." />
          </h2>
          <p class={`${actLead} text-stage-muted`}>
            <T
              id="Aplikasi yang diblokir tertutup layar lembut dengan tombol Back. Tidak ada yang ditutup paksa."
              en="Blocked apps sit behind a calm shield with a Back button. Nothing is force-closed."
            />
          </p>
        </div>
        <div class="mt-10 sm:mt-12">
          <FocusShowcase client:visible />
        </div>
      </div>
    </section>

    <section id="tampilan" class="scroll-mt-16 border-t border-line bg-page">
      <div class={sectionClass}>
        <div data-reveal class={actHead}>
          <h2 class={`${actHeading} text-ink`}>
            <T id="Empat material. Tujuh aksen." en="Four materials. Seven accents." />
          </h2>
          <p class={`${actLead} text-ink-soft`}>
            <T
              id="Liquid Glass, Frosted, Tinted, atau Solid, dengan kontras WCAG AA di setiap aksen."
              en="Liquid Glass, Frosted, Tinted or Solid, with WCAG AA contrast across every accent."
            />
          </p>
        </div>
        <div class="mt-10 sm:mt-12">
          <AppearanceAtelier client:visible />
        </div>
      </div>
    </section>

    <section id="modul" class="scroll-mt-16 border-t border-line bg-paper">
      <div class={sectionClass}>
        <div data-reveal class={actHead}>
          <h2 class={`${actHeading} text-ink`}>
            <T id="13 modul. Pasang atau lepas." en="13 modules. Plug in or out." />
          </h2>
          <p class={`${actLead} text-ink-soft`}>
            <T
              id="Setiap fitur adalah modul yang bisa dinyalakan sendiri. Quick Capture dan Background Cleanup mulai dalam keadaan mati."
              en="Every feature is a module you switch on its own. Quick Capture and Background Cleanup start off."
            />
          </p>
        </div>
        <div class="mt-10 sm:mt-12">
          <ModuleRack client:visible />
        </div>
      </div>
    </section>

    <section id="spotlight" class="scroll-mt-16 on-stage bg-stage text-stage-ink">
      <div class={sectionClass}>
        <div data-reveal class={actHead}>
          <h2 class={`${actHeading} text-stage-ink`}>
            <T id="Cari, lalu jalankan." en="Search, then launch." />
          </h2>
          <p class={`${actLead} text-stage-muted`}>
            <T
              id="Ctrl+Alt+Space membuka aplikasi terpasang dalam daftar atau kisi."
              en="Ctrl+Alt+Space opens your installed apps as a list or a grid."
            />
          </p>
        </div>
        <div class="mt-10 sm:mt-12">
          <Spotlight client:visible />
        </div>
      </div>
    </section>

    <section id="unduh" class="scroll-mt-16 border-t border-line bg-page">
      <div class={`${containerClass} py-20 text-center sm:py-28`}>
        <AgentStack />
        <div data-reveal class="mx-auto mt-10 max-w-[640px] sm:mt-12">
          <h2 class="text-[clamp(2.5rem,5.6vw,4.5rem)] leading-[1.02] font-medium tracking-[-0.035em] text-ink text-balance">
            <T id="Pasang di Windows 11." en="Install on Windows 11." />
          </h2>
          <p class={`${actLead} text-ink-soft`}>
            <T
              id="Tanpa akun, tanpa telemetri, tanpa Electron. Installer per pengguna tanpa UAC."
              en="No account, no telemetry, no Electron. A per-user installer with no UAC prompt."
            />
          </p>
          <div class="mt-8 flex justify-center">
            <BetaDownload />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
