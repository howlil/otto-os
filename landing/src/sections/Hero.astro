---
import BetaDownload from "../components/BetaDownload.astro";
import HeroVisual from "../components/HeroVisual.astro";
---

<section class="bg-sky-low">
  <div class="mx-auto flex w-full max-w-[1140px] flex-col items-center px-4 pt-11 pb-12 text-center sm:px-6 sm:pt-14 sm:pb-16">
    <h1 class="max-w-[780px] text-balance text-[clamp(2.6rem,6vw,3.9rem)] leading-[1.07] font-medium tracking-[-0.043em] text-ink">
      Windows 11, terasa lebih personal.
    </h1>

    <p class="mt-5 max-w-[610px] text-pretty text-base leading-[1.6] text-ink-soft sm:text-lg">
      Top Bar, Dynamic Island, dan Dock yang menyatu dengan desktop.
      Dibangun native dengan Rust untuk Windows 11.
    </p>

    <BetaDownload />

    <div class="mt-12 w-full sm:mt-14">
      <HeroVisual />
    </div>
  </div>
</section>
