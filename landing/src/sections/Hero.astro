---
import { ArrowUpRight } from "lucide-astro";
import HeroVisual from "../components/HeroVisual.astro";
import WaitlistDialog from "../components/WaitlistDialog.astro";
---

<section class="relative isolate overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[url('/hero-bg.webp')] bg-cover bg-top bg-no-repeat"
    style="mask-image: linear-gradient(to bottom, black 71%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 71%, transparent 100%);"
  ></div>

  <div class="mx-auto flex w-full max-w-[1260px] flex-col items-center px-4 pt-28 pb-14 text-center sm:px-6 sm:pt-32 sm:pb-16 lg:pt-32">
    <p class="text-[11px] font-semibold tracking-[0.12em] text-ink-soft">
      PRE-RELEASE <span class="mx-1.5 text-ink/30">/</span> WINDOWS 11
    </p>

    <h1 class="mt-4 max-w-[780px] text-balance text-[clamp(2.55rem,5.5vw,4.1rem)] leading-[1.07] font-semibold tracking-[-0.052em] text-ink">
      Windows 11, terasa lebih personal.
    </h1>

    <p class="mt-4 max-w-[560px] text-pretty text-[15px] leading-[1.65] text-ink-soft sm:text-base">
      Top Bar, Dynamic Island, dan Dock dalam satu pengalaman desktop.
      Dibangun native dengan Rust.
    </p>

    <div id="daftar" class="mt-6 flex w-full scroll-mt-24 flex-col items-center">
      <a
        href="#daftar"
        data-waitlist-trigger
        class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-ink px-7 text-sm font-semibold text-white transition-[background-color,transform] duration-150 hover:bg-[#30343b] active:scale-[0.98] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink motion-reduce:transform-none"
      >
        Join Beta <ArrowUpRight size={16} strokeWidth={1.8} />
      </a>
      <noscript>
        <form method="post" action="/api/waitlist" class="mt-4 flex w-full max-w-sm flex-col gap-2">
          <label for="otto-fallback-email" class="text-left text-xs font-medium text-ink-soft">Email untuk undangan beta</label>
          <input
            id="otto-fallback-email"
            name="email"
            type="email"
            autoComplete="email"
            maxLength={254}
            placeholder="nama@email.com"
            required
            class="h-11 w-full rounded-full border border-line-strong bg-white px-4 text-sm text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          />
          <input name="website" type="text" tabIndex={-1} autoComplete="off" class="sr-only" aria-hidden="true" />
          <button type="submit" class="h-11 rounded-full bg-accent px-5 text-sm font-semibold text-ink">
            Daftar lewat email
          </button>
        </form>
      </noscript>
    </div>

    <div class="mt-9 w-full sm:mt-10">
      <HeroVisual />
    </div>
  </div>

  <WaitlistDialog />
</section>
