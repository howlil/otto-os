---
import BetaDownload from "../components/BetaDownload.astro";
import { T } from "../components/lib/T";
import { HeroStack } from "../components/islands/HeroStack";
---

<section class="relative">
  <div
    class="mx-auto grid w-full max-w-[1200px] items-center gap-12 px-5 pt-12 pb-20 sm:px-8 lg:min-h-[calc(100svh-80px)] lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:gap-10 lg:pt-8 lg:pb-24"
  >
    <div class="max-w-[520px]">
      <h1 class="text-[clamp(2.75rem,6vw,5rem)] leading-[1.02] font-semibold tracking-[-0.035em] text-ink text-balance">
        <T id="Windows 11, dengan ritme macOS." en="Windows 11, with the rhythm of macOS." />
      </h1>
      <p class="mt-6 max-w-[440px] text-lg leading-[1.55] text-ink-soft text-pretty">
        <T
          id="Bar atas, Dynamic Island, dan Dock yang bergerak sebagai satu sistem. Native, lokal, tanpa telemetri."
          en="A top bar, Dynamic Island and Dock that move as one system. Native, local, no telemetry."
        />
      </p>
      <div class="mt-9">
        <BetaDownload />
      </div>
    </div>
    <div>
      <HeroStack client:load />
    </div>
  </div>
</section>
