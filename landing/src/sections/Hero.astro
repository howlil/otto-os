---
import WaitlistForm from "../components/WaitlistForm.tsx";
import HeroVisual from "../components/HeroVisual.astro";
---

<section class="relative isolate overflow-hidden">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[url('/hero-bg.webp')] bg-cover bg-top bg-no-repeat"
    style="mask-image: linear-gradient(to bottom, black 68%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 68%, transparent 100%);"
  >
  </div>

  <div class="mx-auto flex max-w-5xl flex-col items-center px-4 pt-24 pb-12 text-center sm:pt-32 sm:pb-16">
    <p class="text-sm font-medium text-ink-soft">
      Pre-launch beta · Windows 11 22H2+ (64-bit)
    </p>

    <h1 class="mt-3 max-w-3xl text-4xl leading-[1.05] font-semibold tracking-[-0.03em] text-ink text-balance sm:text-5xl lg:text-6xl">
      Windows 11, lebih rapi.
    </h1>

    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft text-pretty sm:text-lg">
      Bar atas, Dock, kontrol jendela Genie, Control Center, dan Dynamic Island dalam satu aplikasi Rust asli. Taskbar bawaan bisa dikembalikan kapan saja.
    </p>

    <div id="daftar" class="mt-8 flex w-full scroll-mt-24 flex-col items-center">
      <WaitlistForm client:load />
      <p class="mt-3 text-xs text-muted">
        Gratis saat beta · Tanpa akun · Tanpa telemetri.
      </p>
      <noscript>
        <p class="mt-2 text-xs text-ink-soft">Formulir tetap dapat dikirim tanpa JavaScript.</p>
      </noscript>
    </div>

    <div class="mt-10 w-full sm:mt-12">
      <HeroVisual />
    </div>
  </div>
</section>
